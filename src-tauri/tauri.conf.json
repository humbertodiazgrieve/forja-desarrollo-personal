{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forja",
  "version": "1.0.0",
  "identifier": "com.forja.personal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forja · Tu progreso, tu leyenda",
        "width": 1440,
        "height": 980,
        "minWidth": 940,
        "minHeight": 680,
        "backgroundColor": "#111513"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Metas, hábitos y diario personal",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    },
    "useLocalToolsDir": true,
    "resources": {
      "vendor/WebView2Loader.dll": "WebView2Loader.dll"
    }
  }
}
